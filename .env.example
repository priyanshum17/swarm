# Swarm Runtime Environment Variables

# Server
SWARM_HOST=0.0.0.0
SWARM_PORT=8000
SWARM_ENV=production

# Redis Checkpointing Backend (falls back to memory if unreachable)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# OpenAI API (leave empty or set SWARM_USE_MOCK_LLM=true for offline mock mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=
SWARM_MODEL=gpt-4o-mini
SWARM_USE_MOCK_LLM=false

# Performance & Recovery
SWARM_ENABLE_PROMPT_CACHING=true
SWARM_MAX_STEPS=30
SWARM_MAX_STEP_RETRIES=3
SWARM_RETRY_BACKOFF=0.5
SWARM_MAX_PARALLEL_STEPS=4
SWARM_STEP_TIMEOUT=30.0
